{
  "name": "rejboard",
  "productName": "RejBoard",
  "version": "1.3.2",
  "description": "Local-first whiteboard and note-taking app with handwriting, PDF annotation, voice recordings, and temporary in-app browsing/video",
  "main": "main.js",
  "author": {
    "name": "Rejwan Shafi",
    "email": "196472099+RejwanShafi25@users.noreply.github.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "libs": "python fetch_libs.py && cd ocr-engine && npm install --omit=dev --ignore-scripts",
    "test": "node --test \"test/*.test.js\"",
    "test:smoke": "node scripts/run-smoke.js",
    "test:ocr": "node scripts/ocr-smoke.js",
    "dist": "electron-builder",
    "test:updates": "node test-update-policy.js"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "mathjs": "^15.2.0",
    "nerdamer": "^1.1.13"
  },
  "build": {
    "appId": "com.rejwan.rejboard",
    "productName": "RejBoard",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "splash.html",
      "board-core.js",
      "math-engine.js",
      "graph-core.js",
      "main.js",
      "lan.js",
      "ocr.js",
      "backup-store.js",
      "preload.js",
      "manifest.json",
      "sw.js",
      "icon.svg",
      "icon-*.png",
      "vendor/**",
      "locales/**",
      "update-policy.js"
    ],
    "extraResources": [
      {
        "from": "ocr-engine/node_modules",
        "to": "ocr/node_modules",
        "filter": [
          "**/*",
          "!.bin/**",
          "!rejboard",
          "!rejboard/**"
        ]
      },
      {
        "from": "ocr-engine/tessdata",
        "to": "ocr/tessdata"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": true,
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "identity": null,
      "hardenedRuntime": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "icon": "build/icon.png",
      "category": "Office",
      "maintainer": "Rejwan Shafi <196472099+RejwanShafi25@users.noreply.github.com>",
      "synopsis": "Local-first whiteboard and note-taking app with handwriting, PDF annotation and per-board voice recordings"
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ],
    "artifactName": "RejBoard-${version}-${os}-${arch}.${ext}",
    "nsis": {
      "artifactName": "RejBoard-${version}-win-${arch}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "RejBoard-${version}-win-${arch}-Portable.${ext}"
    }
  },
  "repository": "github:RejwanShafi25/RejBoard",
  "homepage": "https://github.com/RejwanShafi25/RejBoard",
  "allowScripts": {
    "electron@44.5.1": true
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "lodash.isequal": "^4.5.0"
  }
}
