{
  "name": "rejwan-whiteboard",
  "productName": "Rejwan Whiteboard",
  "version": "1.2.2",
  "description": "Local-first whiteboard and note-taking app with handwriting, PDF annotation and per-board voice recordings",
  "main": "main.js",
  "author": {
    "name": "Rejwan Shafi",
    "email": "196472099+RejwanShafi25@users.noreply.github.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "libs": "python fetch_libs.py",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.rejwan.whiteboard",
    "productName": "Rejwan Whiteboard",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "main.js",
      "lan.js",
      "preload.js",
      "manifest.json",
      "sw.js",
      "icon.svg",
      "icon-*.png",
      "vendor/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": true,
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "identity": null
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "icon": "build/icon.png",
      "category": "Office",
      "maintainer": "Rejwan Shafi <196472099+RejwanShafi25@users.noreply.github.com>",
      "synopsis": "Local-first whiteboard and note-taking app with handwriting, PDF annotation and per-board voice recordings"
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ],
    "artifactName": "Rejwan-Whiteboard-${version}-${os}-${arch}.${ext}",
    "nsis": {
      "artifactName": "Rejwan-Whiteboard-${version}-win-${arch}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "Rejwan-Whiteboard-${version}-win-${arch}-Portable.${ext}"
    }
  },
  "repository": "github:RejwanShafi25/RejBoard",
  "homepage": "https://github.com/RejwanShafi25/RejBoard",
  "allowScripts": {
    "electron@44.5.1": true
  }
}
