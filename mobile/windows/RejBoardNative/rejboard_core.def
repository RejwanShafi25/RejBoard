; Exports of rejboard_core.dll (Kotlin/Native mingwX64, see core/src/mingwX64Main/.../CApi.kt).
; MSVC cannot use MinGW import libraries, so the pre-build step makes rejboard_core.lib from this list.
LIBRARY rejboard_core
EXPORTS
    rb_version
    rb_free
    rb_last_error
    rb_store_open
    rb_store_list
    rb_store_import
    rb_board_scene
    rb_board_title
    rb_free_doubles
    rb_editor_open
    rb_editor_close
    rb_editor_save
    rb_editor_dirty
    rb_view_fit
    rb_view_pan
    rb_view_zoom
    rb_view_get
    rb_set_brush
    rb_set_eraser
    rb_ink_begin
    rb_ink_move
    rb_ink_end
    rb_ink_cancel
    rb_undo
    rb_redo
    rb_ink_version
    rb_draw_paper
    rb_draw_dry
    rb_draw_wet
    rb_dry_generation
    rb_dry_chunk_count
    rb_draw_dry_chunk
    rb_wet_incremental
    rb_wet_generation
    rb_draw_wet_new
    rb_draw_wet_tail
    rb_set_brush_ex
    rb_set_eraser_ex
    rb_set_pen
    rb_last_pressure
